@baseUrl = http://localhost:3000

### 1. Uriel Rivero - promocionado
POST {{baseUrl}}/alumnos
Content-Type: application/json

{
  "nombre": "Uriel Rivero",
  "notas": [8, 9, 10]
}

### 2. Ezequiel Leguiza - aprobado
POST {{baseUrl}}/alumnos
Content-Type: application/json

{
  "nombre": "Ezequiel Leguiza",
  "notas": [6, 7, 6]
}

