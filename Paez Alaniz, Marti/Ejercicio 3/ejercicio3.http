@baseUrl = http://localhost:3003

### Crear una tarea (nace pendiente)
POST {{baseUrl}}/tareas
Content-Type: application/json

{
  "nombre": "Lavar los platos"
}

### Crear otra tarea
POST {{baseUrl}}/tareas
Content-Type: application/json

{
  "nombre": "Estudiar para el parcial"
}

### Error: nombre duplicado
POST {{baseUrl}}/tareas
Content-Type: application/json

{
  "nombre": "Lavar los platos"
}

### Listar todas las tareas
GET {{baseUrl}}/tareas

### Marcar una tarea como completada
PUT {{baseUrl}}/tareas/Lavar los platos
Content-Type: application/json

{
  "completada": true
}

### Listar solo las completadas
GET {{baseUrl}}/tareas?completada=true

### Listar solo las pendientes
GET {{baseUrl}}/tareas?completada=false

### Error: valor inválido en el filtro
GET {{baseUrl}}/tareas?completada=si

### Consultar una tarea puntual
GET {{baseUrl}}/tareas/Estudiar para el parcial

### Error: tarea inexistente
GET {{baseUrl}}/tareas/No Existe

### Eliminar una tarea
DELETE {{baseUrl}}/tareas/Estudiar para el parcial
